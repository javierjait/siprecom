        "backgroundColor": "#FFFFFF"
      },            
      "package": "com.javierjait.siprecom"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a96f09cd-f830-4724-b55d-702e6f538c55"
